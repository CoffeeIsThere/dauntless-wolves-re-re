Imports System.Drawing
Imports System.Drawing.Printing
Imports System.IO
Imports System.Windows.Forms

Public Class ExportService

    ' =========================================================
    '  PDF
    ' =========================================================

    ''' <summary>
    ''' Sends a PrintDocument to the "Microsoft Print to PDF" printer and saves it to a file.
    ''' If that printer is missing it stops with a message (it no longer falls back to a real printer,
    ''' which could print a paper copy by accident).
    ''' </summary>
    Public Function ExportToPDF(printDoc As PrintDocument, targetFilePath As String) As Boolean
        Dim temporaryFile As String = Nothing
        Try
            Dim targetPrinter As String = "Microsoft Print to PDF"
            Dim printerFound As Boolean = False

            For Each installedPrinter As String In PrinterSettings.InstalledPrinters
                If installedPrinter.Equals(targetPrinter, StringComparison.OrdinalIgnoreCase) Then
                    printDoc.PrinterSettings.PrinterName = installedPrinter
                    printerFound = True
                    Exit For
                End If
            Next

            If Not printerFound Then
                MessageBox.Show("The 'Microsoft Print to PDF' printer is not installed on this computer." & vbCrLf &
                                "Turn it on in Windows Features (Optional features) or export to CSV instead.",
                                "PDF Export Error", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Return False
            End If

            If Not String.IsNullOrEmpty(targetFilePath) Then
                printDoc.PrinterSettings.PrintToFile = True
                temporaryFile = Path.Combine(Path.GetDirectoryName(Path.GetFullPath(targetFilePath)), Guid.NewGuid().ToString("N") & ".pdf")
                printDoc.PrinterSettings.PrintFileName = temporaryFile
            End If

            printDoc.Print()
            Dim timer = Stopwatch.StartNew()
            Dim complete = False
            Do
                If temporaryFile IsNot Nothing AndAlso File.Exists(temporaryFile) Then
                    Try
                        Using stream As New FileStream(temporaryFile, FileMode.Open, FileAccess.Read, FileShare.None)
                            If stream.Length >= 5 Then
                                Dim header(4) As Byte
                                stream.ReadExactly(header)
                                complete = System.Text.Encoding.ASCII.GetString(header) = "%PDF-"
                            End If
                        End Using
                    Catch ex As IOException
                        complete = False
                    End Try
                End If
                If complete Then Exit Do
                Threading.Thread.Sleep(100)
            Loop While timer.Elapsed < TimeSpan.FromSeconds(10)
            If Not complete Then
                MessageBox.Show("The PDF file was not created. Check Microsoft Print to PDF and the destination.", "PDF export")
                Return False
            End If
            File.Move(temporaryFile, targetFilePath, True)
            Return True

        Catch ex As Exception
            MessageBox.Show("Failed to generate PDF: " & ex.Message, "Export Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return False
        Finally
            If temporaryFile IsNot Nothing AndAlso File.Exists(temporaryFile) Then
                Try
                    File.Delete(temporaryFile)
                Catch ex As IOException
                    ' The Windows spooler may still be writing a failed job.
                End Try
            End If
        End Try
    End Function

    ''' <summary>
    ''' Builds a multi-page report from whatever is shown in a DataGridView (visible columns only).
    ''' Use it for every PDF export: the number of rows and columns can be anything, paging is automatic.
    '''     Dim doc = _exportService.CreateGridPrintDocument(dgvStudents, "STUDENT DIRECTORY", "Generated by admin")
    '''     _exportService.ExportToPDF(doc, path)
    ''' </summary>
    Public Function CreateGridPrintDocument(dgv As DataGridView, title As String, Optional subtitle As String = "") As PrintDocument
        Dim printer As New GridPrinter(dgv, title, subtitle)
        Dim doc As New PrintDocument()
        doc.DefaultPageSettings.Landscape = printer.ColumnCount > 6
        AddHandler doc.BeginPrint, AddressOf printer.OnBeginPrint
        AddHandler doc.PrintPage, AddressOf printer.OnPrintPage
        Return doc
    End Function

    Public Function CreateTextReportDocument(title As String, description As String, data As DataTable) As PrintDocument
        Dim document As New PrintDocument()
        Dim generated = Date.Now.ToString("MMM d, yyyy HH:mm")
        Dim content = String.Join(vbCrLf & vbCrLf & "────────────────────────" & vbCrLf & vbCrLf,
            data.Rows.Cast(Of DataRow).Select(Function(row) String.Join(vbCrLf, data.Columns.Cast(Of DataColumn).Select(Function(column) column.ColumnName & ": " & ReportValue(row(column))))))
        If content.Length = 0 Then content = "No matching records."
        Dim offset, page As Integer
        AddHandler document.BeginPrint, Sub()
                                            offset = 0 : page = 0
                                        End Sub
        AddHandler document.PrintPage, Sub(sender, args)
                                          page += 1
                                          Using heading As New Font("Segoe UI", 13, FontStyle.Bold), body As New Font("Segoe UI", 10), small As New Font("Segoe UI", 8), format As New StringFormat(StringFormat.GenericTypographic)
                                              format.FormatFlags = StringFormatFlags.LineLimit
                                              Dim bounds = args.MarginBounds
                                              args.Graphics.DrawString(title, heading, Brushes.DarkGreen, bounds.Left, bounds.Top)
                                              Dim subtitle = "Generated " & generated & vbCrLf & description
                                              Dim height = args.Graphics.MeasureString(subtitle, small, bounds.Width).Height + 12
                                              args.Graphics.DrawString(subtitle, small, Brushes.Gray, New RectangleF(bounds.Left, bounds.Top + 30, bounds.Width, height))
                                              Dim area As New RectangleF(bounds.Left, bounds.Top + 30 + height, bounds.Width, bounds.Height - 58 - height)
                                              If area.Height < body.GetHeight(args.Graphics) Then Throw New InvalidOperationException("The printable area is too small.")
                                              Dim characters, lines As Integer
                                              args.Graphics.MeasureString(content.Substring(offset), body, area.Size, format, characters, lines)
                                              If characters <= 0 Then Throw New InvalidOperationException("The printable area is too small.")
                                              args.Graphics.DrawString(content.Substring(offset, characters), body, Brushes.Black, area, format)
                                              offset += characters
                                              args.Graphics.DrawString("Page " & page & " | " & data.Rows.Count & " request(s)", small, Brushes.Gray, bounds.Left, bounds.Bottom - 18)
                                              args.HasMorePages = offset < content.Length
                                          End Using
                                      End Sub
        Return document
    End Function

    Private Class GridPrinter
        Private ReadOnly headers As New List(Of String)
        Private ReadOnly widths As New List(Of Single)
        Private ReadOnly rows As New List(Of String())
        Private ReadOnly identities As New List(Of Integer)
        Private ReadOnly title, subtitle As String
        Private bands As List(Of Integer())
        Private bandIndex, rowIndex, pageNo As Integer
        Private offsets As Integer()

        Public ReadOnly Property ColumnCount As Integer
            Get
                Return headers.Count
            End Get
        End Property

        Public Sub New(grid As DataGridView, reportTitle As String, reportSubtitle As String)
            title = reportTitle : subtitle = reportSubtitle
            Dim columns = grid.Columns.Cast(Of DataGridViewColumn).Where(Function(column) column.Visible).OrderBy(Function(column) column.DisplayIndex).ToList()
            For Each column In columns
                Dim caption = If(String.IsNullOrEmpty(column.HeaderText), column.Name, column.HeaderText)
                headers.Add(caption.Replace(vbCrLf, " ").Replace(vbLf, " "))
                Dim identity = column.Name.Equals("StudentName", StringComparison.OrdinalIgnoreCase) OrElse column.Name.Equals("Student", StringComparison.OrdinalIgnoreCase) OrElse column.Name.Equals("No", StringComparison.OrdinalIgnoreCase)
                If identity Then identities.Add(headers.Count - 1)
                widths.Add(If(column.Name.Equals("No", StringComparison.OrdinalIgnoreCase), 40.0F, If(identity, 180.0F, Math.Max(100.0F, Math.Min(220.0F, column.Width)))))
            Next
            For Each row As DataGridViewRow In grid.Rows
                If row.IsNewRow OrElse Not row.Visible Then Continue For
                rows.Add(columns.Select(Function(column) Convert.ToString(row.Cells(column.Index).Value)).ToArray())
            Next
        End Sub

        Public Sub OnBeginPrint(sender As Object, args As PrintEventArgs)
            bandIndex = 0 : rowIndex = 0 : pageNo = 0 : bands = Nothing : offsets = Nothing
        End Sub

        Public Sub OnPrintPage(sender As Object, args As PrintPageEventArgs)
            pageNo += 1
            Dim bounds = args.MarginBounds
            If bands Is Nothing Then
                ' Leave space for at least one data column even on a narrow paper size.
                Dim identityCap = bounds.Width / CSng(Math.Max(3, identities.Count + 2))
                For index = 0 To widths.Count - 1
                    widths(index) = Math.Min(widths(index), If(identities.Contains(index), identityCap, bounds.Width / 2.0F))
                Next
                bands = ReportColumnBands.Build(widths, identities, bounds.Width)
            End If
            Using heading As New Font("Segoe UI", 13, FontStyle.Bold), small As New Font("Segoe UI", 8),
                  headerFont As New Font("Segoe UI", 9, FontStyle.Bold), bodyFont As New Font("Segoe UI", 9),
                  format As New StringFormat(StringFormat.GenericTypographic), headerBrush As New SolidBrush(Color.FromArgb(224, 240, 228))
                format.FormatFlags = StringFormatFlags.LineLimit
                Dim y As Single = bounds.Top
                args.Graphics.DrawString(title, heading, Brushes.DarkGreen, bounds.Left, y) : y += 28
                Dim description = subtitle & "   |   Generated " & Date.Now.ToString("MMM d, yyyy HH:mm")
                Dim descriptionHeight = args.Graphics.MeasureString(description, small, bounds.Width).Height + 8
                args.Graphics.DrawString(description, small, Brushes.Gray, New RectangleF(bounds.Left, y, bounds.Width, descriptionHeight))
                y += descriptionHeight
                If bands.Count = 0 Then
                    args.Graphics.DrawString("No visible columns to export.", bodyFont, Brushes.Black, bounds.Left, y)
                    args.HasMorePages = False
                    Return
                End If
                Dim band = bands(bandIndex)
                args.Graphics.DrawString("Column group " & (bandIndex + 1) & " of " & bands.Count, small, Brushes.Gray, bounds.Left, y) : y += 20
                Dim headerHeight = band.Max(Function(index) args.Graphics.MeasureString(headers(index), headerFont, CInt(widths(index) - 8)).Height) + 10
                Dim x As Single = bounds.Left
                For Each index In band
                    Dim rectangle As New RectangleF(x, y, widths(index), headerHeight)
                    args.Graphics.FillRectangle(headerBrush, rectangle)
                    args.Graphics.DrawString(headers(index), headerFont, Brushes.DarkGreen, New RectangleF(x + 4, y + 4, widths(index) - 8, headerHeight - 8), format)
                    x += widths(index)
                Next
                y += headerHeight
                Dim bodyTop = y
                Dim bottom As Single = bounds.Bottom - 26
                If bottom - bodyTop < bodyFont.GetHeight(args.Graphics) + 10 Then Throw New InvalidOperationException("The printable page is too small for this report.")
                While rowIndex < rows.Count
                    If offsets Is Nothing Then offsets = New Integer(headers.Count - 1) {}
                    Dim remaining = bottom - y
                    If remaining < bodyFont.GetHeight(args.Graphics) + 10 Then Exit While
                    Dim height As Single = 24
                    For Each index In band
                        height = Math.Max(height, args.Graphics.MeasureString(rows(rowIndex)(index).Substring(offsets(index)), bodyFont, CInt(widths(index) - 8)).Height + 10)
                    Next
                    ' Start ordinary rows on the next page rather than splitting them needlessly.
                    If height > remaining AndAlso y > bodyTop Then Exit While
                    Dim fragmentHeight = Math.Min(height, remaining)
                    Dim advanced = False
                    x = bounds.Left
                    For Each index In band
                        Dim text = rows(rowIndex)(index).Substring(offsets(index))
                        Dim characters, lines As Integer
                        Dim area As New RectangleF(x + 4, y + 4, widths(index) - 8, fragmentHeight - 8)
                        If text.Length > 0 Then
                            args.Graphics.MeasureString(text, bodyFont, area.Size, format, characters, lines)
                            If characters > 0 Then
                                args.Graphics.DrawString(text.Substring(0, characters), bodyFont, Brushes.Black, area, format)
                                offsets(index) += characters : advanced = True
                            End If
                        End If
                        args.Graphics.DrawRectangle(Pens.LightGray, x, y, widths(index), fragmentHeight)
                        x += widths(index)
                    Next
                    y += fragmentHeight
                    If band.All(Function(index) offsets(index) >= rows(rowIndex)(index).Length) Then
                        rowIndex += 1 : offsets = Nothing
                    Else
                        If Not advanced Then Throw New InvalidOperationException("Text cannot fit in the printable area.")
                        Exit While
                    End If
                End While
                args.Graphics.DrawString("Page " & pageNo & " | " & rows.Count & " record(s)", small, Brushes.Gray, bounds.Left, bounds.Bottom - 18)
                If rowIndex >= rows.Count Then
                    bandIndex += 1 : rowIndex = 0 : offsets = Nothing
                End If
                args.HasMorePages = bandIndex < bands.Count
            End Using
        End Sub
    End Class

    ' =========================================================
    '  CSV
    ' =========================================================

    ''' <summary>
    ''' Saves the visible columns of a DataGridView to a CSV file (values with quotes, commas or line breaks are escaped).
    ''' </summary>
    Public Function ExportToCSV(dgv As DataGridView, filePath As String) As Boolean
        Try
            Dim lines As New List(Of String)()

            Dim headers As New List(Of String)()
            For Each col As DataGridViewColumn In dgv.Columns
                If col.Visible Then
                    headers.Add(CsvField(col.HeaderText.Replace(vbCrLf, " ").Replace(vbLf, " ")))
                End If
            Next
            lines.Add(String.Join(",", headers))

            For Each row As DataGridViewRow In dgv.Rows
                If row.IsNewRow Then Continue For
                Dim cells As New List(Of String)()
                For Each col As DataGridViewColumn In dgv.Columns
                    If col.Visible Then
                        Dim v As Object = row.Cells(col.Index).Value
                        cells.Add(CsvField(If(v Is Nothing OrElse Convert.IsDBNull(v), "", Convert.ToString(v))))
                    End If
                Next
                lines.Add(String.Join(",", cells))
            Next

            File.WriteAllLines(filePath, lines, System.Text.Encoding.UTF8)
            Return True

        Catch ex As Exception
            MessageBox.Show("Error saving CSV file: " & ex.Message, "CSV Export Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return False
        End Try
    End Function

    Public Function ExportTableToCSV(data As DataTable, filePath As String) As Boolean
        Try
            Using writer As New StreamWriter(filePath, False, System.Text.Encoding.UTF8)
                writer.WriteLine(String.Join(",", data.Columns.Cast(Of DataColumn).Select(Function(column) CsvField(column.ColumnName))))
                For Each row As DataRow In data.Rows
                    writer.WriteLine(String.Join(",", data.Columns.Cast(Of DataColumn).Select(Function(column) CsvField(ReportValue(row(column))))))
                Next
            End Using
            Return True
        Catch ex As Exception
            MessageBox.Show("Error saving CSV file: " & ex.Message, "CSV Export Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return False
        End Try
    End Function

    Private Shared Function ReportValue(value As Object) As String
        If value Is Nothing OrElse IsDBNull(value) Then Return ""
        If TypeOf value Is DateTime Then Return CDate(value).ToString("yyyy-MM-dd HH:mm:ss", Globalization.CultureInfo.InvariantCulture)
        Return Convert.ToString(value, Globalization.CultureInfo.InvariantCulture)
    End Function

    ' Wraps a value in quotes and DOUBLES any quote inside it ("" is how CSV writes one quote)
    Private Shared Function CsvField(value As String) As String
        Return """" & value.Replace("""", """""") & """"
    End Function

End Class